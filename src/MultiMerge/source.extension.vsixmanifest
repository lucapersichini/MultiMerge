<?xml version="1.0" encoding="utf-8"?>
<!-- Modified by Luca Persichini in 2026 for the MultiMerge fork; see NOTICE.txt. -->
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="MultiMerge.VS2026.c7d9470c-00e2-48d4-8a71-12036e43005f" Version="1.2.0" Language="en-US" Publisher="Luca Persichini" />
        <DisplayName>MultiMerge for Visual Studio 2026</DisplayName>
        <Description xml:space="preserve">Task-based transfers for Git and TFVC: select changes, preview branches, apply policies, resolve conflicts, and deliver to multiple Git targets.</Description>
        <License>LICENSE.txt</License>
        <ReleaseNotes>https://github.com/lucapersichini/MultiMerge/blob/feature/git-preview/RELEASE_NOTES.md</ReleaseNotes>
        <Icon>Resources/merge.png</Icon>
        <Tags>git, tfvc, tfs, azure devops, azure boards, work item, changeset, cherry-pick, backport, branch merge, conflict resolution, merge policy</Tags>
    </Metadata>
    <Installation InstalledByMsi="false">
        <InstallationTarget Version="[17.14,)" Id="Microsoft.VisualStudio.Pro">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Version="[17.14,)" Id="Microsoft.VisualStudio.Enterprise">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Dependencies>
        <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
        <Dependency d:Source="Installed" Version="[17.0,18.0)" Id="Microsoft.VisualStudio.MPF.17.0" DisplayName="Visual Studio MPF 17.0" />
    </Dependencies>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
        <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
    </Assets>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
</PackageManifest>
