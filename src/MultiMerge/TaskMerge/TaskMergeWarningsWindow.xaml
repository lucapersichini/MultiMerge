<Window x:Class="MultiMerge.TaskMergeWarningsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="MultiMerge - merge warnings" Width="820" Height="560"
        MinWidth="480" MinHeight="300" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,10,0,12" TextWrapping="Wrap"
                   Text="Review the warnings before starting. You can minimize this window to inspect Visual Studio. The merge waits for your confirmation." />
        <TextBox x:Name="WarningsText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Padding="10" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" Click="Cancel_Click"
                    MinWidth="100" Padding="12,6" Margin="0,0,10,0" />
            <Button x:Name="ConfirmButton" Content="Start merge anyway" Click="Confirm_Click"
                    MinWidth="150" Padding="12,6" />
        </StackPanel>
    </Grid>
</Window>