<!-- Modified by Luca Persichini in 2026 for the MultiMerge fork; see NOTICE.txt. -->
<UserControl x:Class="MultiMerge.TaskMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:multiMerge="clr-namespace:MultiMerge;assembly="
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vsutil="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance multiMerge:TaskMergeViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vsutil:BrushToColorConverter x:Key="BrushToColor" />

    <!-- Colori di stato fissi: mid-tone leggibili sia col tema scuro sia col chiaro. Tutto il resto
         (sfondi, testi, bordi, selezione) viene dal tema di VS. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FA34D" />
    <SolidColorBrush x:Key="RunningBrush" Color="#2B88D8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D98C00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />

    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Card e riquadri: solo bordo dal tema, sfondo della tool window. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Colori dal tema di VS: niente colori fissi, cosi' il tema scuro resta leggibile. -->
    <Style x:Key="ThemedListView" TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
    </Style>
    <!-- Template proprio: quello di sistema ha hover/pressed con sfondo chiaro fisso, illeggibile col
         testo chiaro del tema scuro. PART_HeaderGripper tiene il ridimensionamento delle colonne. -->
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingBackgroundKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GridHeadingTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,2,6,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Grid>
              <Border x:Name="HeaderBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="0,0,1,1"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextHoverKey}}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverOverSelectedKey}}" />
              </Trigger>
              <Trigger Property="Role" Value="Padding">
                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,0,0,1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ListBox senza il template di sistema (che da disabilitato mette uno sfondo chiaro fisso). -->
    <Style x:Key="ThemedListBox" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Riga della lista conflitti: selezione e hover col colore di evidenziazione del tema. -->
    <Style x:Key="ConflictListItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,6,8,6" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Hover" Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" Opacity="0" />
              <Border x:Name="Selection" Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.18" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pulsante a forma di link (azioni secondarie). -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Label" Background="Transparent" TextWrapping="Wrap"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- "Edit" / "Hide" dell'intestazione compatta: riapre le caselle (stato solo di vista). -->
    <Style x:Key="LinkToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <imaging:CrispImage x:Name="Icon" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                  Moniker="{x:Static catalog:KnownMonikers.Edit}" />
              <TextBlock x:Name="Label" VerticalAlignment="Center" Text="Edit" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Label" Property="Text" Value="Hide" />
                <Setter TargetName="Icon" Property="Moniker" Value="{x:Static catalog:KnownMonikers.CollapseUp}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Parti dell'intestazione che la modalita' compatta nasconde finche' non si preme "Edit". -->
    <Style x:Key="EditableHeaderPart" TargetType="FrameworkElement">
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsCompactHeader}" Value="True" />
            <Condition Binding="{Binding IsHeaderEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Collapsed" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Divisore verticale fra lista dei conflitti e resolver: linea del tema + maniglia al centro. -->
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="9" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ResizeDirection" Value="Columns" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="SizeWE" />
      <Setter Property="ToolTip" Value="Drag to resize the conflict list" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center" Opacity="0"
                         Fill="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
              <Border x:Name="Grip" Width="4" Height="40" CornerRadius="2" Opacity="0.55"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Opacity" Value="1" />
                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pulsante con sola icona (es. Refresh). -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Hover" CornerRadius="2" Opacity="0"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
              <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.22" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Expander del registro: template proprio (quello di sistema disegna la freccia con colori fissi). -->
    <Style x:Key="LogExpander" TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Left" Cursor="Hand"
                            Foreground="{TemplateBinding Foreground}"
                            Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,3,8,3">
                      <StackPanel Orientation="Horizontal">
                        <Path x:Name="Arrow" Width="7" Height="9" Margin="1,0,7,0" VerticalAlignment="Center"
                              Stretch="Fill" Data="M 0,0 L 4,4.5 L 0,9 Z"
                              Fill="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmento della barra di avanzamento: un passo, colorato per stato. -->
    <Style x:Key="StepSegment" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Merged">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="AlreadyMerged">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Merging">
          <Setter Property="Background" Value="{StaticResource RunningBrush}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard Name="PulseMerging">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.6" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="PulseMerging" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Conflicts">
          <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed">
          <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Blocked">
          <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
        <!-- Saltato per le regole di merge: grigio del tema, attenuato -->
        <DataTrigger Binding="{Binding Status}" Value="Skipped">
          <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
          <Setter Property="Opacity" Value="0.45" />
        </DataTrigger>
        <!-- Parte dopo un check-in non ancora fatto: segmento attenuato (ultimo trigger: vince) -->
        <DataTrigger Binding="{Binding IsLocked}" Value="True">
          <Setter Property="Opacity" Value="0.35" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Linea verticale del punto di check-in nella barra: grigia da raggiungere, ambra quando la
         catena aspetta il check-in di quella parte, verde quando e' superato. -->
    <Style x:Key="CheckpointLine" TargetType="Rectangle">
      <Setter Property="Fill" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Active">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard Name="PulseCheckpoint">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.8" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="PulseCheckpoint" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Passed">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Passi raggruppati per parte (intestazione di gruppo e riga "Check-in point" tra le parti). -->
    <CollectionViewSource x:Key="StepsView" Source="{Binding Steps}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="PartInfo" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <!-- Pallino di stato nella lista dei passi (stessi colori dei segmenti). -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Merged">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="AlreadyMerged">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Merging">
          <Setter Property="Fill" Value="{StaticResource RunningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Conflicts">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed">
          <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Blocked">
          <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
          <Setter Property="Opacity" Value="0.6" />
        </DataTrigger>
        <!-- Saltato per le regole di merge: cerchio vuoto -->
        <DataTrigger Binding="{Binding Status}" Value="Skipped">
          <Setter Property="Fill" Value="Transparent" />
          <Setter Property="Stroke" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
          <Setter Property="StrokeThickness" Value="1.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Banner di stato: tinta leggera + striscia a sinistra + icona, secondo StatusKind. -->
    <Style x:Key="BannerTint" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Opacity" Value="0.14" />
      <Setter Property="Background" Value="{StaticResource RunningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BannerStripe" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10,8,10,8" />
      <Setter Property="BorderBrush" Value="{StaticResource RunningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompactHeader}" Value="True">
          <Setter Property="Padding" Value="10,5,10,5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Testo del banner: in modalita' compatta una riga sola (troncata, testo intero nel ToolTip),
         tranne gli errori, che vanno letti per intero. -->
    <Style x:Key="BannerText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsCompactHeader}" Value="True">
          <Setter Property="TextWrapping" Value="NoWrap" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="TextTrimming" Value="None" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BannerIcon" TargetType="{x:Type imaging:CrispImage}">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Running">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusRunning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusOK}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <!-- ImageBackgroundColor: le icone CrispImage si adattano allo sfondo del tema (chiaro/scuro). -->
  <!-- Con catena in corso o conflitti aperti (IsCompactHeader) l'intestazione e' una riga sola e
       l'area principale (riga 3, "*") prende tutta l'altezza restante. -->
  <Grid Margin="12,8,12,6"
        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushToColor}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />                   <!-- 0 card: input, titolo, cartelle -->
      <RowDefinition Height="Auto" />                   <!-- 1 barra segmentata + azioni -->
      <RowDefinition Height="Auto" />                   <!-- 2 banner di stato -->
      <RowDefinition Height="*" MinHeight="180" />      <!-- 3 conflitti + resolver, oppure passi -->
      <RowDefinition Height="Auto" />                   <!-- 4 registro -->
    </Grid.RowDefinitions>

    <!-- 0: card con work item, target, titolo e cartelle (compatta: una riga + "Edit") -->
    <Border Grid.Row="0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Setter Property="Padding" Value="12,10,12,10" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactHeader}" Value="True">
              <Setter Property="Padding" Value="10,5,10,5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <!-- Riga compatta: #id, titolo, source -> target, Edit -->
        <DockPanel Visibility="{Binding IsCompactHeader, Converter={StaticResource BoolToVisibility}}">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeaderEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                  <Setter Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <ToggleButton DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource LinkToggle}"
                        IsChecked="{Binding IsHeaderEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        ToolTip="Show or hide the work item, target and workspace fields"
                        AutomationProperties.Name="Edit work item, target and workspace" />
          <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                  Style="{StaticResource LinkButton}"
                  ToolTip="Open the merge policies: team rules of the target branch and your personal rules (personal ones always win)"
                  Content="Policies..." Command="{Binding OpenPoliciesCommand}" />
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                              Moniker="{x:Static catalog:KnownMonikers.WorkItem}" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
              <StackPanel MaxWidth="700">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                  <Run Text="{Binding LoadedWorkItemText, Mode=OneWay}" />
                  <Run Text="{Binding WorkItemTitle, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap">
                  <Run Text="{Binding SourceTopFolder, Mode=OneWay}" />
                  <Run Text="&#x2192;" />
                  <Run Text="{Binding TargetFolder, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </TextBlock.ToolTip>
            <Run FontWeight="SemiBold" Text="{Binding LoadedWorkItemText, Mode=OneWay}" />
            <Run FontWeight="SemiBold" Text="{Binding WorkItemTitle, Mode=OneWay}" />
            <Run Text="   " />
            <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="{Binding SourceTopFolder, Mode=OneWay}" />
            <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text=" &#x2192; " />
            <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="{Binding TargetFolder, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>

        <Grid Style="{StaticResource EditableHeaderPart}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Work item" />
          <TextBox Grid.Column="1" VerticalAlignment="Center" Padding="3"
                   Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                   ToolTip="ID of the task whose changesets are merged"
                   Text="{Binding WorkItemIdText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" Text="Target branch" />
          <TextBox Grid.Column="3" VerticalAlignment="Center" Padding="3"
                   Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                   ToolTip="Server path of the target branch, e.g. $/Project/Release"
                   Text="{Binding TargetBranchText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="4" Margin="10,0,0,0" MinWidth="80" Padding="12,3"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  ToolTip="Read the task, plan the merge file by file and preview every step with TFVC (nothing is changed)"
                  Content="Load" Command="{Binding LoadCommand}" />
          <Button Grid.Column="5" Margin="8,0,0,0" MinWidth="80" Padding="10,3"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  ToolTip="Merge policies: rules by path (Merge, Discard, Skip) and protected lines, from the team file of the target branch and your personal file (personal rules always win)"
                  Command="{Binding OpenPoliciesCommand}">
            <StackPanel Orientation="Horizontal">
              <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" Moniker="{x:Static catalog:KnownMonikers.Policy}" />
              <TextBlock VerticalAlignment="Center" Text="Policies..." />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Titolo del work item (solo intestazione completa: in quella compatta e' nella prima riga) -->
        <DockPanel Margin="0,12,0,0">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding WorkItemTitle}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompactHeader}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                              Moniker="{x:Static catalog:KnownMonikers.WorkItem}" />
          <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Text="{Binding WorkItemTitle}" ToolTip="{Binding WorkItemTitle}" />
        </DockPanel>

        <!-- source folder -> target folder (solo intestazione completa) -->
        <TextBlock Margin="24,4,0,0" TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasSteps}" Value="True" />
                    <Condition Binding="{Binding IsCompactHeader}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="{Binding SourceTopFolder, Mode=OneWay}" />
          <Run Text="  &#x2192;  " />
          <Run Text="{Binding TargetFolder, Mode=OneWay}" />
        </TextBlock>

        <!-- Source branch (solo con piu' gruppi) e workspace (compatta: solo con "Edit") -->
        <WrapPanel Margin="0,10,0,0" Style="{StaticResource EditableHeaderPart}">
          <StackPanel Orientation="Horizontal" Margin="0,0,20,4"
                      Visibility="{Binding HasMultipleGroups, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Source branch" />
            <ComboBox Width="300"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                      ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeSelection}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type multiMerge:TaskChangesetGroup}">
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} ({1} changesets)">
                        <Binding Path="SourceBranch" />
                        <Binding Path="ChangesetIds.Count" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Workspace" />
            <ComboBox Width="260"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                      ItemsSource="{Binding Workspaces}"
                      SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      IsEnabled="{Binding CanChangeSelection}" />
          </StackPanel>
        </WrapPanel>

        <!-- Changeset del task con le caselle: un changeset escluso non entra nel piano (per il
             planner diventa un changeset "di terzi"). Modificabili solo senza catena in corso. -->
        <StackPanel Style="{StaticResource EditableHeaderPart}">
          <Expander Margin="0,8,0,0" IsExpanded="False" Style="{StaticResource LogExpander}"
                    Visibility="{Binding HasTaskChangesets, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{Binding ChangesetsHeaderText}" />
                <imaging:CrispImage Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Moniker="{x:Static catalog:KnownMonikers.StatusWarning}"
                                    ToolTip="Some selected changesets change items also changed by excluded ones"
                                    Visibility="{Binding HasDependencyWarnings, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Expander.Header>
            <Border Margin="0,4,0,0" Style="{StaticResource Card}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,10,4">
                  <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top"
                          Style="{StaticResource LinkButton}"
                          ToolTip="Include every changeset, then press Update plan"
                          Content="Select all" Command="{Binding SelectAllChangesetsCommand}" />
                  <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top"
                          Style="{StaticResource LinkButton}"
                          ToolTip="Plan the merge again with the changesets checked below"
                          Content="Update plan"
                          Visibility="{Binding ShowRecomputePlan, Converter={StaticResource BoolToVisibility}}"
                          Command="{Binding RecomputePlanCommand}" />
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                             Text="Change the checkboxes, or highlight rows with Ctrl/Shift and include or exclude them together. Press Update plan when finished. Excluded changesets are treated like other people's changesets." />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,0,10,6">
                  <WrapPanel>
                    <Button Content="Include selected" Margin="0,0,8,0"
                            Command="{Binding IncludeChangesetsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=TaskChangesetsList}" />
                    <Button Content="Exclude selected"
                            Command="{Binding ExcludeChangesetsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=TaskChangesetsList}" />
                  </WrapPanel>
                  <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Selection changed: the steps and warnings below belong to the previous plan. Update plan before starting the merge."
                             Visibility="{Binding HasStaleSelection, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                  <ListBox x:Name="TaskChangesetsList" ItemsSource="{Binding TaskChangesets}"
                           SelectionMode="Extended" SelectionChanged="TaskChangesetsList_SelectionChanged"
                           Style="{StaticResource ThemedListBox}" ItemContainerStyle="{StaticResource ConflictListItem}"
                           MaxHeight="220" Margin="0,0,0,6"
                                Grid.IsSharedSizeScope="True"
                                IsEnabled="{Binding CanChangeSelection}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type multiMerge:TaskMergeChangesetViewModel}">
                        <Grid Margin="10,2,10,2" Background="Transparent" ToolTip="{Binding ToolTipText}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CsCheck" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CsId" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CsDate" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CsAuthor" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CsCount" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding IdText}" />
                          <TextBlock Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                     Text="{Binding IdText}" />
                          <TextBlock Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryText}" Text="{Binding DateText}" />
                          <TextBlock Grid.Column="3" Margin="0,0,12,0" MaxWidth="200" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Author}" />
                          <TextBlock Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Style="{StaticResource SecondaryText}" Text="{Binding ItemCountText}" />
                          <TextBlock Grid.Column="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Text="{Binding CommentFirstLine}" />
                          <!-- Avviso di dipendenza accanto al changeset -->
                          <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="6,1,0,2"
                                     Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                            <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top"
                                                Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding WarningText}" />
                          </DockPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
              </DockPanel>
            </Border>
          </Expander>
        </StackPanel>

        <!-- Avviso: input cambiato dopo l'ultimo Load (a catena in corso: rimettere i valori) -->
        <DockPanel Margin="0,6,0,0"
                   Visibility="{Binding HasStaleInput, Converter={StaticResource BoolToVisibility}}">
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                              Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
          <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"
                  Style="{StaticResource LinkButton}"
                  ToolTip="Put back the work item and the target of the loaded plan"
                  Content="Restore" Command="{Binding RestoreInputCommand}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding StaleInputText}" />
        </DockPanel>

        <!-- Richiesta di Team Explorer in attesa (catena in corso o scheda occupata) -->
        <DockPanel Margin="0,6,0,0"
                   Visibility="{Binding HasTeamExplorerRequest, Converter={StaticResource BoolToVisibility}}">
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                              Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" />
          <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding TeamExplorerRequestText}" />
            <WrapPanel Margin="0,3,0,0">
              <Button Margin="0,0,16,0" Style="{StaticResource LinkButton}"
                      ToolTip="Load the work item asked by Team Explorer (a chain that is not finished is discarded only after you confirm)"
                      Content="{Binding LoadRequestButtonText}" Command="{Binding LoadRequestCommand}" />
              <Button Style="{StaticResource LinkButton}"
                      ToolTip="Forget the request and keep working on the current chain"
                      Content="Dismiss" Command="{Binding DismissRequestCommand}" />
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- 1: barra segmentata (un segmento sottile per passo, un punto di check-in tra le parti) +
         avanzamento + azioni principali -->
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="120" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Height="18" VerticalAlignment="Center">
        <!-- Binario vuoto finche' non c'e' un piano -->
        <Border CornerRadius="3" Opacity="0.6" Margin="0,2,0,2"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasSteps}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <ItemsControl ItemsSource="{Binding BarItems}" Focusable="False">
          <ItemsControl.Resources>
            <!-- Passo: segmento colorato per stato -->
            <DataTemplate DataType="{x:Type multiMerge:TaskMergeStepViewModel}">
              <Border Style="{StaticResource StepSegment}" Margin="0,2,0,2" CornerRadius="1"
                      ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="150" />
            </DataTemplate>
            <!-- Punto di check-in: separatore verticale con l'icona del check-in -->
            <DataTemplate DataType="{x:Type multiMerge:TaskMergeCheckpointMarkerViewModel}">
              <Grid Width="24" Background="Transparent" Margin="2,0,3,0"
                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="150"
                    AutomationProperties.Name="{Binding ToolTipText}">
                <Rectangle Width="2" HorizontalAlignment="Center" Style="{StaticResource CheckpointLine}" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="1" CornerRadius="2"
                        Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
                  <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.CheckIn}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.Resources>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <multiMerge:TaskMergeStepBarPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCheckpointMarker}" Value="True">
                  <Setter Property="multiMerge:TaskMergeStepBarPanel.IsFixedWidth" Value="True" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </Grid>
      <TextBlock Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"
                 Text="{Binding ProgressText}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <!-- Start / Continue -->
        <Button MinWidth="130" Padding="12,4"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Merge the steps in order; the chain stops at conflicts and at check-in points and continues by itself once they are handled"
                Command="{Binding StartCommand}">
          <StackPanel Orientation="Horizontal">
            <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" Moniker="{x:Static catalog:KnownMonikers.Play}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StartButtonText}" />
          </StackPanel>
        </Button>
        <!-- Punto di check-in / fine catena: check-in con conferma -->
        <Button MinWidth="130" Padding="12,4"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                Visibility="{Binding ShowCheckInActions, Converter={StaticResource BoolToVisibility}}"
                ToolTip="{Binding CheckInToolTip}"
                Command="{Binding CheckInCommand}">
          <StackPanel Orientation="Horizontal">
            <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" Moniker="{x:Static catalog:KnownMonikers.CheckIn}" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CheckInButtonText}" />
          </StackPanel>
        </Button>
        <Button MinWidth="110" Margin="8,0,0,0" Padding="12,4"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                ToolTip="Open Pending Changes with the merged files, the comment of the part and the work item; at a check-in point the chain continues by itself after you check in there"
                Command="{Binding ReviewPendingChangesCommand}">
          <StackPanel Orientation="Horizontal">
            <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" Moniker="{x:Static catalog:KnownMonikers.CheckInItem}" />
            <TextBlock VerticalAlignment="Center" Text="Review in Pending Changes" />
          </StackPanel>
        </Button>
        <!-- Al punto di check-in: per chi ha archiviato altrove (stessa verifica di Continue) -->
        <Button Margin="12,0,0,0" VerticalAlignment="Center"
                Style="{StaticResource LinkButton}"
                Visibility="{Binding ShowContinueLink, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Checked in elsewhere? Continue verifies that nothing is pending under the target, then goes on with the next part"
                Content="Continue" Command="{Binding StartCommand}" />
      </StackPanel>
    </Grid>

    <!-- 2: banner di stato (compatto: una riga, testo intero nel ToolTip) -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Border Style="{StaticResource BannerTint}" />
      <Border Style="{StaticResource BannerStripe}">
        <DockPanel>
          <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top"
                              Style="{StaticResource BannerIcon}" />
          <TextBlock Style="{StaticResource BannerText}" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- 3: area principale -->
    <Grid Grid.Row="3" Margin="0,8,0,0">

      <!-- Con conflitti aperti: lista dei conflitti a sinistra, resolver integrato a destra -->
      <Grid Visibility="{Binding ShowConflictsPanel, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" MinWidth="170" MaxWidth="560" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="10,8,6,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                      ToolTip="Read the open conflicts again from TFVC"
                      Command="{Binding RefreshConflictsCommand}">
                <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Refresh}" />
              </Button>
              <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ConflictsHeaderText}" />
            </DockPanel>
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="10,7,10,8"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
              <Button HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                      ToolTip="Fallback for cases the inline resolver cannot handle: opens the Visual Studio Resolve Conflicts page for the selected file. Press Refresh here when done."
                      Content="Open in VS Resolve Conflicts"
                      Command="{Binding OpenInVsResolveConflictsCommand}" />
            </Border>
            <ListBox Style="{StaticResource ThemedListBox}"
                     ItemContainerStyle="{StaticResource ConflictListItem}"
                     ItemsSource="{Binding Conflicts}"
                     SelectedItem="{Binding SelectedConflict, Mode=TwoWay}"
                     IsEnabled="{Binding CanSelectConflict}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type multiMerge:TaskMergeConflictViewModel}">
                  <DockPanel ToolTip="{Binding Path}">
                    <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top">
                      <imaging:CrispImage.Style>
                        <Style TargetType="{x:Type imaging:CrispImage}">
                          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CanMergeContent}" Value="True">
                              <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.Conflict}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </imaging:CrispImage.Style>
                    </imaging:CrispImage>
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" />
                      <TextBlock Opacity="0.75" TextTrimming="CharacterEllipsis" Text="{Binding Folder}" />
                      <TextBlock Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding TypeText}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />

        <!-- Resolver integrato del conflitto selezionato: la vista viene creata nel code-behind, una
             nuova per ogni resolver (vedi TaskMergeView.ShowActiveResolver). -->
        <Grid Grid.Column="2">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="Select a conflict on the left to resolve it here.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasActiveResolver}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ContentControl x:Name="ResolverHost" Focusable="False"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Grid>

      <!-- Senza conflitti: lista dei passi a tutta larghezza, raggruppati per parte -->
      <Border Style="{StaticResource Card}"
              Visibility="{Binding ShowStepList, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <!-- Problemi del piano: errori (Start disabilitato) e avvisi -->
          <Border DockPanel.Dock="Top" Padding="10,8,10,8" BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                  Visibility="{Binding HasPlanIssues, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <!-- Esito dell'ultimo controllo finale prima del check-in: bloccanti e note -->
                <ItemsControl ItemsSource="{Binding AuditNotices}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type multiMerge:TaskMergeNotice}">
                      <DockPanel Margin="0,1,0,1">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                          <imaging:CrispImage.Style>
                            <Style TargetType="{x:Type imaging:CrispImage}">
                              <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                  <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusError}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </imaging:CrispImage.Style>
                        </imaging:CrispImage>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding PlanErrors}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1,0,1">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                            Moniker="{x:Static catalog:KnownMonikers.StatusError}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Problemi delle regole di merge (Start disabilitato) -->
                <ItemsControl ItemsSource="{Binding PolicyErrors}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1,0,1">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                            Moniker="{x:Static catalog:KnownMonikers.StatusError}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding PlanWarnings}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1,0,1">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                            Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Avvisi di sicurezza (changeset esclusi, colleghi non fusi nel target): Start chiede conferma -->
                <ItemsControl ItemsSource="{Binding SafetyWarnings}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,1,0,1">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                            Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Riepilogo del piano dopo l'anteprima -->
          <TextBlock DockPanel.Dock="Top" Margin="10,6,10,4" TextTrimming="CharacterEllipsis"
                     Style="{StaticResource SecondaryText}"
                     Text="{Binding PlanSummaryText}" ToolTip="{Binding PlanSummaryText}"
                     Visibility="{Binding HasPlanSummary, Converter={StaticResource BoolToVisibility}}" />

          <!-- Regole di merge del piano: riepilogo (tooltip: da dove vengono) e accesso alla scheda -->
          <DockPanel DockPanel.Dock="Top" Margin="10,0,10,4"
                     Visibility="{Binding HasPolicySummary, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                    Style="{StaticResource LinkButton}"
                    ToolTip="Open the merge policies (team rules of the target branch and your personal rules)"
                    Content="Policies..." Command="{Binding OpenPoliciesCommand}" />
            <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                Moniker="{x:Static catalog:KnownMonikers.Policy}" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding PolicySummaryText}">
              <TextBlock.ToolTip>
                <StackPanel MaxWidth="700">
                  <TextBlock TextWrapping="Wrap" Text="{Binding PolicySummaryText}" />
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding PolicyDescriptionText}" />
                  <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                             Text="Change the action of a step in the Policy column (only before it is merged): the change applies to this merge only." />
                </StackPanel>
              </TextBlock.ToolTip>
            </TextBlock>
          </DockPanel>

          <!-- Regole cambiate durante una catena: valgono dal prossimo Load -->
          <DockPanel DockPanel.Dock="Top" Margin="10,0,10,4"
                     Visibility="{Binding HasPolicyNotice, Converter={StaticResource BoolToVisibility}}">
            <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top"
                                Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding PolicyNoticeText}" />
          </DockPanel>

          <!-- Promemoria: cio' che le regole di merge lasciano da fare a mano -->
          <Expander DockPanel.Dock="Top" Margin="10,0,10,4" IsExpanded="False" Style="{StaticResource LogExpander}"
                    Visibility="{Binding HasFollowUps, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Moniker="{x:Static catalog:KnownMonikers.TaskList}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding FollowUpsHeaderText}" />
              </StackPanel>
            </Expander.Header>
            <Border Margin="0,4,0,0" Style="{StaticResource Card}">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,10,4">
                  <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top"
                          Style="{StaticResource LinkButton}"
                          ToolTip="Copy the list (with every detail) to the clipboard"
                          Content="Copy" Command="{Binding CopyFollowUpsCommand}" />
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                             Text="What the merge policies left out of this merge: task changes on protected lines (the target's version is kept), new files with protected lines, discarded and skipped items. Check them by hand." />
                </DockPanel>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding FollowUps}" Focusable="False" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type multiMerge:TaskMergeFollowUpViewModel}">
                        <DockPanel Margin="10,2,10,3" Background="Transparent" ToolTip="{Binding ToolTipText}">
                          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top">
                            <imaging:CrispImage.Style>
                              <Style TargetType="{x:Type imaging:CrispImage}">
                                <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.Lock}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </imaging:CrispImage.Style>
                          </imaging:CrispImage>
                          <StackPanel>
                            <TextBlock TextWrapping="Wrap">
                              <Run FontWeight="SemiBold" Text="{Binding ItemPath, Mode=OneWay}" />
                              <Run Text="  " />
                              <Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Margin="0,1,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                                       Text="{Binding DetailsText}"
                                       Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Expander>

          <!-- Centinaia di passi: virtualizzazione anche con il raggruppamento -->
          <ListView Style="{StaticResource ThemedListView}" BorderThickness="0" Margin="1"
                    ItemsSource="{Binding Source={StaticResource StepsView}}"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <!-- Passi delle parti dopo un check-in non ancora fatto: visibili ma grigi e non interattivi.
                 Non selezionabili (niente focus, i clic li scarta LockedStep_PreviewMouseDown) ma
                 raggiungibili dal mouse: i tooltip (colleghi in mezzo, "Available after the check-in
                 of part N") devono restare visibili proprio su quelle righe.
                 Niente BasedOn="{StaticResource {x:Type ListViewItem}}": il tema di sistema non ha una
                 risorsa con quella chiave e il caricamento della vista fallirebbe (XamlParseException);
                 lo stile del tema (DefaultStyleKey della GridView) si applica comunque sotto questo. -->
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <!-- Template proprio: quello di sistema colora la riga selezionata/sotto il mouse con
                     un azzurro chiaro fisso, illeggibile con il testo chiaro del tema scuro (visto in
                     VS 2026). Colori di selezione e hover dal tema di VS. -->
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border x:Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}"
                              SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="RowBorder" Property="Background"
                                  Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="RowBorder" Property="Background"
                                  Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                          <Setter Property="Foreground"
                                  Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="LockedStep_PreviewMouseDown" />
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="LockedStep_PreviewMouseDown" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Focusable" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <!-- DataContext: il gruppo; Name e' la parte (TaskMergePartViewModel) -->
                  <DataTemplate>
                    <StackPanel Margin="0,2,0,2">
                      <!-- Riga "Check-in point" tra la parte precedente e questa -->
                      <Border Margin="0,6,0,6" Padding="8,4,8,4" BorderThickness="0,1,0,1"
                              BorderBrush="{StaticResource WarningBrush}"
                              ToolTip="{Binding Name.CheckpointBeforeToolTip}"
                              Visibility="{Binding Name.HasCheckpointBefore, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                              Moniker="{x:Static catalog:KnownMonikers.CheckIn}" />
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     Text="{Binding Name.CheckpointBeforeText}" />
                        </DockPanel>
                      </Border>
                      <TextBlock Margin="6,2,0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name.HeaderToolTip}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Name.IsLocked}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                        <Run FontWeight="SemiBold" Text="{Binding Name.HeaderText, Mode=OneWay}" />
                        <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="{Binding Name.LockedSuffix, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="#" Width="48" DisplayMemberBinding="{Binding Number}" />
                <GridViewColumn Header="Item" Width="380">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type multiMerge:TaskMergeStepViewModel}">
                      <DockPanel Background="Transparent" ToolTip="{Binding ItemToolTip}">
                        <!-- Item cambiato da colleghi tra i changeset del task -->
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                            Moniker="{x:Static catalog:KnownMonikers.Team}"
                                            Visibility="{Binding IsInterleaved, Converter={StaticResource BoolToVisibility}}" />
                        <!-- ...e quei changeset non sono tutti nel target -->
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                            Moniker="{x:Static catalog:KnownMonikers.StatusWarning}"
                                            Visibility="{Binding HasColleagueWarning, Converter={StaticResource BoolToVisibility}}" />
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                          <imaging:CrispImage.Style>
                            <Style TargetType="{x:Type imaging:CrispImage}">
                              <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.Document}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                  <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.FolderClosed}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </imaging:CrispImage.Style>
                        </imaging:CrispImage>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding RelativePath}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInterleaved}" Value="True">
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DockPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Change" Width="90" DisplayMemberBinding="{Binding ChangeText}" />
                <GridViewColumn Header="Range" Width="150" DisplayMemberBinding="{Binding RangeText}" />
                <!-- Regola di merge del passo: lucchetto se ha righe protette, azione (modificabile solo
                     prima del merge, per questa esecuzione) e da dove viene (id della regola o "set here");
                     origine e dettagli nel tooltip -->
                <GridViewColumn Header="Policy" Width="210">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type multiMerge:TaskMergeStepViewModel}">
                      <DockPanel Background="Transparent" ToolTip="{Binding PolicyToolTip}" ToolTipService.ShowOnDisabled="True">
                        <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                            Moniker="{x:Static catalog:KnownMonikers.Lock}"
                                            Visibility="{Binding HasProtectedLines, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox DockPanel.Dock="Left" MinWidth="84" VerticalAlignment="Center"
                                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                                  ItemsSource="{x:Static multiMerge:TaskMergeStepViewModel.PolicyActions}"
                                  SelectedItem="{Binding PolicyAction, Mode=TwoWay}"
                                  IsEnabled="{Binding IsPolicyEditable}"
                                  AutomationProperties.Name="Merge policy action of the step" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding PolicySourceText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPolicyOverridden}" Value="True">
                                  <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DockPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Status" Width="130">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type multiMerge:TaskMergeStepViewModel}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Details" Width="400">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type multiMerge:TaskMergeStepViewModel}">
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding DetailsText}" ToolTip="{Binding DetailsToolTip}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>

    <!-- 4: registro, chiuso di default; aperto resta sotto i 180 px -->
    <Expander Grid.Row="4" Margin="0,5,0,0" MaxHeight="180" Style="{StaticResource LogExpander}" Header="Log" IsExpanded="False">
      <TextBox x:Name="LogTextBox" Height="150" Margin="0,3,0,0"
               Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
               IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
               FontFamily="Consolas"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top"
               Text="{Binding LogText, Mode=OneWay}"
               TextChanged="LogTextBox_TextChanged" />
    </Expander>
  </Grid>
</UserControl>
