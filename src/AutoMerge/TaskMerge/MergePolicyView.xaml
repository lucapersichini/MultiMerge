<UserControl x:Class="AutoMerge.MergePolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:autoMerge="clr-namespace:AutoMerge;assembly="
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vsutil="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance autoMerge:MergePolicyViewModel}"
             d:DesignHeight="900" d:DesignWidth="1100"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vsutil:BrushToColorConverter x:Key="BrushToColor" />

    <!-- Colori di stato fissi (gli stessi di Merge from Task): mid-tone leggibili sia col tema scuro
         sia col chiaro. Tutto il resto (sfondi, testi, bordi, selezione) viene dal tema di VS. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FA34D" />
    <SolidColorBrush x:Key="RunningBrush" Color="#2B88D8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D98C00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />

    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,4,12,0" />
    </Style>

    <!-- Errore di un campo: nascosto finche' non c'e' testo. -->
    <Style x:Key="FieldError" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Nota secondaria di un campo: nascosta finche' non c'e' testo. -->
    <Style x:Key="FieldNote" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Avviso di un campo (colore ambra): nascosto finche' non c'e' testo. -->
    <Style x:Key="FieldWarning" TargetType="TextBlock" BasedOn="{StaticResource FieldError}">
      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>

    <!-- Card e riquadri: solo bordo dal tema, sfondo della tool window. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10,12,10" />
    </Style>

    <!-- Pulsante a forma di link (azioni secondarie). -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Label" Background="Transparent" TextWrapping="Wrap"
                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ControlLinkTextHoverKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pulsante con sola icona (azioni di una riga). -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Hover" CornerRadius="2" Opacity="0"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
              <ContentPresenter Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.22" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Banner di stato: tinta leggera + striscia a sinistra + icona, secondo StatusKind. -->
    <Style x:Key="BannerTint" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Opacity" Value="0.14" />
      <Setter Property="Background" Value="{StaticResource RunningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BannerStripe" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10,7,10,7" />
      <Setter Property="BorderBrush" Value="{StaticResource RunningBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BannerIcon" TargetType="{x:Type imaging:CrispImage}">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Running">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusRunning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusOK}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Icona di stato dei due file (team / personale). -->
    <Style x:Key="TeamStatusIcon" TargetType="{x:Type imaging:CrispImage}">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TeamStatusKind}" Value="Success">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusOK}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TeamStatusKind}" Value="Warning">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TeamStatusKind}" Value="Error">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PersonalStatusIcon" TargetType="{x:Type imaging:CrispImage}">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding PersonalStatusKind}" Value="Success">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusOK}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding PersonalStatusKind}" Value="Warning">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding PersonalStatusKind}" Value="Error">
          <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Esito del tester: tinta del colore della decisione. -->
    <Style x:Key="TestResultTint" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Opacity" Value="0.22" />
      <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TestResultKind}" Value="Discard">
          <Setter Property="Background" Value="{StaticResource RunningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TestResultKind}" Value="Skip">
          <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding TestResultKind}" Value="Error">
          <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Intestazione delle colonne degli elenchi di regole (stesse larghezze delle righe). -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Una riga di regola (percorso o riga): abilitazione, ordine, origine, pattern, dettaglio, azioni. -->
    <DataTemplate x:Key="RuleRowTemplate" DataType="{x:Type autoMerge:MergePolicyRuleRowViewModel}">
      <Border x:Name="RowBorder" Padding="8,5,8,5" BorderThickness="0,0,0,1" Background="Transparent"
              BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="2*" MinWidth="120" />
            <ColumnDefinition Width="3*" MinWidth="140" />
            <ColumnDefinition Width="170" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,1,0,0"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}"
                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                    Command="{Binding ToggleEnabledCommand}"
                    ToolTip="{Binding EnabledToolTip}"
                    AutomationProperties.Name="Rule enabled" />
          <TextBlock Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource SecondaryText}" Text="{Binding OrderText}"
                     ToolTip="Evaluation order: for path rules the first enabled rule that matches wins" />
          <StackPanel x:Name="OriginPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" ToolTip="{Binding ToolTipText}">
            <imaging:CrispImage Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
              <imaging:CrispImage.Style>
                <Style TargetType="{x:Type imaging:CrispImage}">
                  <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.User}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTeam}" Value="True">
                      <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.Team}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </imaging:CrispImage.Style>
            </imaging:CrispImage>
            <TextBlock VerticalAlignment="Center" Text="{Binding OriginText}" />
          </StackPanel>
          <TextBlock x:Name="PatternBlock" Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Top"
                     FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                     Text="{Binding PatternText}" ToolTip="{Binding PatternText}" />
          <StackPanel x:Name="DetailPanel" Grid.Column="4" Margin="0,0,12,0">
            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding DetailText}" ToolTip="{Binding DetailToolTip}" />
            <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="{Binding Description}"
                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource FieldWarning}" Text="{Binding NotAppliedReason}" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Button Margin="0,1,10,0" VerticalAlignment="Top" Style="{StaticResource LinkButton}"
                    Content="Override"
                    ToolTip="Copy this team rule to your personal file with the same Id: your copy replaces it for you (for example to disable it only for you)"
                    Visibility="{Binding CanOverride, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding OverrideCommand}" />
            <Button Style="{StaticResource IconButton}" Command="{Binding EditCommand}"
                    ToolTip="Edit the rule" AutomationProperties.Name="Edit the rule">
              <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.Edit}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding MoveUpCommand}"
                    ToolTip="Move up in its file (path rules: the first match wins)" AutomationProperties.Name="Move the rule up">
              <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.MoveUp}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding MoveDownCommand}"
                    ToolTip="Move down in its file" AutomationProperties.Name="Move the rule down">
              <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.MoveDown}" />
            </Button>
            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                    ToolTip="Delete the rule from its file" AutomationProperties.Name="Delete the rule">
              <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static catalog:KnownMonikers.DeleteListItem}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
          <Setter TargetName="PatternBlock" Property="Opacity" Value="0.5" />
          <Setter TargetName="DetailPanel" Property="Opacity" Value="0.5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsApplied}" Value="False">
          <Setter TargetName="PatternBlock" Property="Opacity" Value="0.5" />
          <Setter TargetName="OriginPanel" Property="Opacity" Value="0.6" />
          <Setter TargetName="PatternBlock" Property="TextDecorations" Value="Strikethrough" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- ImageBackgroundColor: le icone CrispImage si adattano allo sfondo del tema (chiaro/scuro). -->
  <Grid Margin="12,8,12,6"
        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushToColor}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- 0 intestazione: ramo di destinazione e workspace -->
      <RowDefinition Height="Auto" />   <!-- 1 banner di stato -->
      <RowDefinition Height="*" />      <!-- 2 file, regole, editor, tester -->
    </Grid.RowDefinitions>

    <!-- 0: intestazione -->
    <Border Grid.Row="0" Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                              Moniker="{x:Static catalog:KnownMonikers.Policy}" />
          <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <Run Text="Merge policies for" />
            <Run Text="{Binding LoadedTargetText, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>
        <TextBlock Margin="24,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                   Text="Path rules decide, file by file, whether Merge from Task merges it (Merge), records it as merged but keeps the target content (Discard) or leaves it out (Skip). Line rules protect lines: in the matching files those lines keep the target version and the source changes to them are listed as things to do by hand. Personal rules come first and always win over a team rule with the same Id." />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Target branch" />
          <TextBox Grid.Column="1" VerticalAlignment="Center" Padding="3"
                   Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                   ToolTip="Server path of the target branch, e.g. $/Project/Release: its team file is read from the root of this branch"
                   Text="{Binding TargetBranchText, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="2" Margin="10,0,0,0" MinWidth="80" Padding="12,3"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  ToolTip="Read the team file (latest version in the branch, or your pending version) and the personal file again"
                  Content="Load" Command="{Binding LoadCommand}" />
          <TextBlock Grid.Column="3" Margin="20,0,8,0" VerticalAlignment="Center" Text="Workspace" />
          <TextBlock Grid.Column="4" MaxWidth="280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Style="{StaticResource SecondaryText}"
                     Text="{Binding WorkspaceText}" ToolTip="{Binding WorkspaceText}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 1: banner di stato -->
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <Border Style="{StaticResource BannerTint}" />
      <Border Style="{StaticResource BannerStripe}">
        <DockPanel>
          <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Style="{StaticResource BannerIcon}" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- 2: contenuto scorrevole -->
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,4,8">

        <!-- File di team e file personale -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Moniker="{x:Static catalog:KnownMonikers.Team}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="Team file" />
              </DockPanel>
              <TextBlock Margin="24,2,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                         Text="Lives in the root of the target branch and applies to everyone merging into it. Merges read the version checked in." />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource SecondaryText}" Text="Server path" />
                <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding TeamServerPathText}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,3,10,0" Style="{StaticResource SecondaryText}" Text="Local path" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding TeamLocalPathText}" />
              </Grid>
              <DockPanel Margin="0,8,0,0">
                <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Style="{StaticResource TeamStatusIcon}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding TeamStatusText}" />
              </DockPanel>
              <Button Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="130" Padding="12,4"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Write the team file in your workspace and create a pending add or edit. Nothing is checked in: review and check in the file from Pending Changes."
                      Content="Save to team file (creates a pending change)"
                      Command="{Binding SaveTeamCommand}" />
              <TextBlock Style="{StaticResource FieldNote}" Text="{Binding TeamSaveHint}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Moniker="{x:Static catalog:KnownMonikers.User}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="Personal file" />
              </DockPanel>
              <TextBlock Margin="24,2,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                         Text="Only for you, for every branch. Its rules come first and always win over the team rules." />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource SecondaryText}" Text="Path" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding PersonalPathText, Mode=OneWay}" />
              </Grid>
              <DockPanel Margin="0,8,0,0">
                <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" Style="{StaticResource PersonalStatusIcon}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding PersonalStatusText}" />
              </DockPanel>
              <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                      ToolTip="Open the personal file in the editor (after editing it by hand, save it and press Load)"
                      Content="Open file" Command="{Binding OpenPersonalFileCommand}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Errori delle regole (engine) e dei file -->
        <Border Margin="0,8,0,0" Style="{StaticResource Card}"
                Visibility="{Binding HasPolicyErrors, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <DockPanel>
              <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Moniker="{x:Static catalog:KnownMonikers.StatusError}" />
              <TextBlock Style="{StaticResource SectionTitle}" Text="Errors in the rules" />
            </DockPanel>
            <ItemsControl Margin="24,4,0,0" ItemsSource="{Binding PolicyErrors}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Aggiunta di regole e modelli pronti -->
        <Border Margin="0,8,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <WrapPanel>
              <TextBlock Margin="0,0,8,6" VerticalAlignment="Center" Text="New rules go to" />
              <ComboBox Width="300" Margin="0,0,20,6" VerticalAlignment="Center"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                        ItemsSource="{Binding AddTargetOptions}"
                        DisplayMemberPath="Text"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding AddTarget, Mode=TwoWay}"
                        IsEnabled="{Binding AreRowsEnabled}"
                        AutomationProperties.Name="File for new rules and presets" />
            </WrapPanel>
            <WrapPanel>
              <Button Margin="0,0,8,6" MinWidth="110" Padding="10,3"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Decide for the files matching a pattern: Merge, Discard or Skip"
                      Content="Add path rule" Command="{Binding AddPathRuleCommand}" />
              <Button Margin="0,0,20,6" MinWidth="110" Padding="10,3"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Protect lines (or blocks of lines) in the files matching a pattern: they keep the target version"
                      Content="Add line rule" Command="{Binding AddLineRuleCommand}" />
              <TextBlock Margin="0,0,8,6" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="Presets:" />
              <Button Margin="0,0,8,6" Padding="10,3"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Protect the references and versions of your own NuGet packages (by id prefix) in packages.config, project files, binding redirects and Directory.Packages.props"
                      Content="Add NuGet preset..." Command="{Binding ShowNuGetPromptCommand}" />
              <Button Margin="0,0,8,6" Padding="10,3"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Discard Directory.Packages.props: the central package versions of the target stay as they are"
                      Content="Central Package Management" Command="{Binding AddCentralPackageManagementPresetCommand}" />
              <Button Margin="0,0,8,6" Padding="10,3"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      ToolTip="Protect the AssemblyVersion, AssemblyFileVersion and AssemblyInformationalVersion lines (C# and VB)"
                      Content="Assembly versions" Command="{Binding AddAssemblyVersionPresetCommand}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldWarning}" Text="{Binding AddTargetHint}" />

            <!-- Richiesta dei prefissi per il modello NuGet -->
            <Border Margin="0,8,0,0" Style="{StaticResource Card}"
                    Visibility="{Binding IsNuGetPromptOpen, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap">
                  <Run FontWeight="SemiBold" Text="NuGet preset" />
                  <Run Text="- the rules are added to" />
                  <Run Text="{Binding NuGetTargetText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="Package id prefixes of the packages whose references and versions must keep the target version, separated by commas (compared literally, case-insensitive). Adding the preset again replaces its rules: list all the prefixes." />
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                          Content="Cancel" Command="{Binding CancelNuGetPresetCommand}" />
                  <Button DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="80" Padding="12,3"
                          Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                          Content="Add" Command="{Binding ApplyNuGetPresetCommand}" />
                  <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" VerticalAlignment="Center"
                           AutomationProperties.Name="Package id prefixes"
                           ToolTip="For example: Contoso., Fabrikam.Core"
                           Text="{Binding NuGetPrefixesText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding ApplyNuGetPresetCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding NuGetPrefixesError}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Editor della regola (nuova, modificata o sostituzione personale di una di team) -->
        <Border Margin="0,8,0,0" Style="{StaticResource Card}" BorderThickness="2"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
                Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
          <StackPanel DataContext="{Binding Editor}" Grid.IsSharedSizeScope="True">
            <DockPanel>
              <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Moniker="{x:Static catalog:KnownMonikers.Edit}" />
              <TextBlock Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
            </DockPanel>

            <!-- Id -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Id" />
              <StackPanel Grid.Column="1">
                <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" MaxWidth="400" HorizontalAlignment="Left" MinWidth="240"
                         AutomationProperties.Name="Rule Id"
                         ToolTip="Unique in its file. A personal rule with the same Id as a team rule replaces it for you."
                         Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding IdError}" />
                <TextBlock Style="{StaticResource FieldNote}" Text="{Binding IdInfo}" />
              </StackPanel>
            </Grid>

            <!-- Regola di percorso: pattern e azione -->
            <Grid Margin="0,6,0,0" Visibility="{Binding IsPathRule, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Path pattern" />
              <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="Path pattern"
                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding PatternError}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="Relative to the root of the target branch, '/' between folders: ** = any folders (also none), * = any characters in a name, ? = one character. A pattern without '/' matches the file name in any folder." />
              </StackPanel>
              <TextBlock Grid.Row="1" Margin="0,10,12,0" Style="{StaticResource FieldLabel}" Text="Action" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Width="420" HorizontalAlignment="Left"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                        AutomationProperties.Name="Action"
                        ItemsSource="{Binding ActionOptions}"
                        DisplayMemberPath="Text"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Action, Mode=TwoWay}" />
            </Grid>

            <!-- Regola di riga: file, modo, regex -->
            <Grid Margin="0,6,0,0" Visibility="{Binding IsLineRule, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Files" />
              <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="File pattern"
                         Text="{Binding FilePattern, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding FilePatternError}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="Same patterns as the path rules, e.g. **/*.csproj or packages.config." />
              </StackPanel>
              <TextBlock Grid.Row="1" Margin="0,10,12,0" Style="{StaticResource FieldLabel}" Text="Protect" />
              <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Width="420" HorizontalAlignment="Left"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}"
                        AutomationProperties.Name="Protect single lines or blocks"
                        ItemsSource="{Binding ModeOptions}"
                        DisplayMemberPath="Text"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding IsBlockMode, Mode=TwoWay}" />

              <!-- Righe singole -->
              <TextBlock Grid.Row="2" Margin="0,10,12,0" Style="{StaticResource FieldLabel}" Text="Line regex"
                         Visibility="{Binding ShowLinePattern, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                          Visibility="{Binding ShowLinePattern, Converter={StaticResource BoolToVisibility}}">
                <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="Line regular expression"
                         Text="{Binding LinePattern, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding LinePatternError}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="A .NET regular expression tested on each line (without the line break)." />
              </StackPanel>

              <!-- Blocchi -->
              <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                          Visibility="{Binding ShowBlockPatterns, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Block start regex" />
                  <StackPanel Grid.Column="1">
                    <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="Block start regular expression"
                             Text="{Binding BlockStartPattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding BlockStartError}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Block end regex" />
                  <StackPanel Grid.Column="1">
                    <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="Block end regular expression"
                             Text="{Binding BlockEndPattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding BlockEndError}" />
                  </StackPanel>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="Block contains regex" />
                  <StackPanel Grid.Column="1">
                    <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" AutomationProperties.Name="Block contains regular expression (optional)"
                             Text="{Binding BlockContainsPattern, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding BlockContainsError}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="A block goes from a start line to the first end line after it (included). Optional: with a 'contains' regex, only the blocks with a matching line are protected." />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Descrizione e abilitazione -->
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
              <TextBox Grid.Column="1" Padding="3"
                       Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                       AutomationProperties.Name="Description"
                       Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Grid.Column="1"
                        Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}"
                        Content="Enabled"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
            </Grid>

            <!-- Prova della regola di riga su un testo d'esempio -->
            <Grid Margin="0,8,0,0" Visibility="{Binding IsLineRule, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Try it on" />
              <StackPanel Grid.Column="1">
                <TextBox Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3" Height="70"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Sample text to try the rule on"
                         ToolTip="Paste a few lines of a matching file: the lines this rule protects are listed below"
                         Text="{Binding SampleText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldNote}" Text="{Binding SampleResultText}" />
              </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldError}" Text="{Binding EngineErrorText}" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
              <Button MinWidth="110" Padding="12,4"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                      Content="{Binding ApplyText}"
                      Command="{Binding DataContext.ApplyEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              <Button Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                      Content="Cancel"
                      Command="{Binding DataContext.CancelEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Regole di percorso effettive -->
        <DockPanel Margin="0,14,0,0">
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                              Moniker="{x:Static catalog:KnownMonikers.FolderOpened}" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="Path rules" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                     Text="In evaluation order: the first enabled rule that matches decides; no match = Merge." />
        </DockPanel>
        <Border Margin="0,4,0,0" Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Border Padding="8,4,8,4" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="2*" MinWidth="120" />
                  <ColumnDefinition Width="3*" MinWidth="140" />
                  <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="On" />
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="#" />
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Origin" />
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Pattern" />
                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Action" />
              </Grid>
            </Border>
            <TextBlock Margin="10,8,10,8" Text="No path rules: every file is merged.">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPathRules}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding PathRules}" ItemTemplate="{StaticResource RuleRowTemplate}"
                          IsEnabled="{Binding AreRowsEnabled}" Focusable="False" />
          </StackPanel>
        </Border>

        <!-- Regole di riga effettive -->
        <DockPanel Margin="0,14,0,0">
          <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                              Moniker="{x:Static catalog:KnownMonikers.Lock}" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="Line rules (protected lines)" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                     Text="Every enabled rule whose file pattern matches applies: its lines keep the target version." />
        </DockPanel>
        <Border Margin="0,4,0,0" Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Border Padding="8,4,8,4" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="2*" MinWidth="120" />
                  <ColumnDefinition Width="3*" MinWidth="140" />
                  <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="On" />
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="#" />
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Origin" />
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Files" />
                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Protected lines" />
              </Grid>
            </Border>
            <TextBlock Margin="10,8,10,8" Text="No line rules: no line is protected.">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasLineRules}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding LineRules}" ItemTemplate="{StaticResource RuleRowTemplate}"
                          IsEnabled="{Binding AreRowsEnabled}" Focusable="False" />
          </StackPanel>
        </Border>

        <!-- Tester: un percorso -> decisione, regola che vince, righe protette -->
        <Border Margin="0,14,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Moniker="{x:Static catalog:KnownMonikers.Test}" />
              <TextBlock Style="{StaticResource SectionTitle}" Text="Test a path" />
            </DockPanel>
            <TextBox Margin="0,8,0,0" Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" FontFamily="Consolas" Padding="3"
                     AutomationProperties.Name="Path to test"
                     ToolTip="Relative to the target branch (e.g. src/App/App.csproj); a server path under the branch or a local path under its mapped folder also works"
                     Text="{Binding TestPathText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                       Text="Relative to the target branch, e.g. src/App/App.csproj (a server path under the branch or a local path under its mapped folder also works)." />
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Style="{StaticResource SecondaryText}">
                <Run Text="Relative path:" />
                <Run FontFamily="Consolas" Text="{Binding TestNormalizedPathText, Mode=OneWay}" />
              </TextBlock>
              <DockPanel Margin="0,6,0,0">
                <Grid DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top">
                  <Border Style="{StaticResource TestResultTint}" />
                  <TextBlock Margin="8,2,8,2" FontWeight="SemiBold" Text="{Binding TestResultKind}" />
                </Grid>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding TestDecisionText}" />
              </DockPanel>
              <TextBlock Style="{StaticResource FieldNote}" Margin="0,6,0,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                         Text="{Binding TestRuleText}" />
              <TextBlock Style="{StaticResource FieldNote}" Margin="0,6,0,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                         Text="{Binding TestLineRulesHeader}" />
              <ItemsControl Margin="16,2,0,0" ItemsSource="{Binding TestLineRules}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,1,0,0" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource FieldWarning}" Margin="0,6,0,0" Text="{Binding TestNoteText}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
