<UserControl x:Class="AutoMerge.ConflictResolverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:autoMerge="clr-namespace:AutoMerge;assembly="
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:vsutil="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance autoMerge:ConflictResolverViewModel}"
             d:DesignHeight="640" d:DesignWidth="1100"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vsutil:BrushToColorConverter x:Key="BrushToColor" />

    <!-- Colori fissi solo per gli accenti di stato: mid-tone leggibili sia col tema scuro sia col
         chiaro. Sfondi, testi, bordi e selezione vengono dal tema di VS. -->
    <SolidColorBrush x:Key="SourceBrush" Color="#2B88D8" />
    <SolidColorBrush x:Key="TargetBrush" Color="#D98C00" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FA34D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D98C00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />

    <Style x:Key="SecondaryText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
    </Style>

    <!-- Tutte le icone: 16x16, attenuate quando il pulsante che le contiene e' disabilitato. -->
    <Style TargetType="{x:Type imaging:CrispImage}">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Etichetta di un riquadro (SOURCE / TARGET / RESULT): barretta colorata a sinistra + testo, una
         riga sola. -->
    <Style x:Key="PaneHeader" TargetType="Border">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="6,0,0,0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Height" Value="17" />
    </Style>

    <!-- Stato dei blocchi accanto al contatore: pallino arancio finche' ne restano, verde a zero. Il
         testo del contatore resta nel colore del tema (arancio su sfondo chiaro si legge male). -->
    <Style x:Key="CounterDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasRemainingConflicts}" Value="True">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Pulsanti e caselle usano gli stili di VS per DynamicResource (BasedOn vorrebbe una StaticResource
         che esiste solo dentro VS): le misure piu' compatte sono attributi locali. -->

    <!-- Divisore trascinabile fra confronto e risultato: linea del tema + maniglia al centro, evidenziati
         col colore di selezione del tema al passaggio del mouse e durante il trascinamento. -->
    <Style x:Key="RowSplitter" TargetType="GridSplitter">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ResizeDirection" Value="Rows" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="SizeNS" />
      <Setter Property="ToolTip" Value="Drag to resize the comparison and the result" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center"
                         Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
              <Border x:Name="Grip" Width="40" Height="4" CornerRadius="2" Opacity="0.55"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                <Setter TargetName="Grip" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- ImageBackgroundColor: le icone CrispImage si adattano allo sfondo del tema (chiaro/scuro). -->
  <Grid Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource BrushToColor}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />   <!-- 0 barra superiore: file + navigazione + scelte sul blocco -->
      <RowDefinition Height="Auto" />   <!-- 1 errore -->
      <RowDefinition Height="Auto" />   <!-- 2 avvertenza sulla fusione -->
      <RowDefinition Height="*" />      <!-- 3 corpo: caricamento / editor / card -->
      <RowDefinition Height="Auto" />   <!-- 4 piede -->
    </Grid.RowDefinitions>

    <!-- 0: a sinistra icona + nome del file (grassetto) + path (grigio, troncato); a destra contatore,
         frecce e scelte sul blocco corrente (solo con l'editor a tre vie). Su una riga se c'e' posto;
         con la colonna stretta i pulsanti vanno sotto il titolo invece di essere tagliati
         (ConflictHeaderPanel). -->
    <Border Grid.Row="0" MinHeight="38" Padding="10,4,8,4" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
      <autoMerge:ConflictHeaderPanel VerticalAlignment="Center" MinTitleWidth="160" ColumnSpacing="12" RowSpacing="4">
        <!-- titolo -->
        <DockPanel VerticalAlignment="Center">
          <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,8,0" Moniker="{x:Static catalog:KnownMonikers.Conflict}" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
              <StackPanel MaxWidth="700">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Path=Path, Mode=OneWay}" />
                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding ConflictDescription, Mode=OneWay}" />
              </StackPanel>
            </TextBlock.ToolTip>
            <Run FontWeight="SemiBold" Text="{Binding FileName, Mode=OneWay}" />
            <Run Text=" " />
            <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="{Binding Path=Path, Mode=OneWay}" />
          </TextBlock>
        </DockPanel>

        <!-- navigazione: stato + contatore + frecce -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibility}}">
          <Ellipse Style="{StaticResource CounterDot}" ToolTip="{Binding ConflictBlocksText, Mode=OneWay}" />
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                     Text="{Binding ConflictNavigatorText, Mode=OneWay}"
                     ToolTip="{Binding ConflictBlocksText, Mode=OneWay}" />
          <Button MinWidth="0" MinHeight="24" Padding="4,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding PreviousConflictCommand}"
                  ToolTip="Previous conflict" AutomationProperties.Name="Previous conflict">
            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Previous}" />
          </Button>
          <Button Margin="3,0,0,0" MinWidth="0" MinHeight="24" Padding="4,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding NextConflictCommand}"
                  ToolTip="Next conflict" AutomationProperties.Name="Next conflict">
            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Next}" />
          </Button>
        </StackPanel>

        <!-- separatore fra navigazione e scelte (sparisce quando stanno su righe diverse) -->
        <Rectangle Width="1" Margin="10,3" VerticalAlignment="Stretch"
                   Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                   Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibility}}" />

        <!-- scelte sul blocco corrente: vanno a capo se non stanno nemmeno su una riga intera -->
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                   Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibility}}">
          <Button Margin="0,1,4,1" MinWidth="0" MinHeight="24" Padding="7,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding TakeSourceBlockCommand}"
                  ToolTip="Replace the current conflict with the SOURCE (incoming) lines">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="14" Margin="0,0,5,0" Fill="{StaticResource SourceBrush}" />
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.TakeSourceVersion}" />
              <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Take source" />
            </StackPanel>
          </Button>
          <Button Margin="0,1,4,1" MinWidth="0" MinHeight="24" Padding="7,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding TakeTargetBlockCommand}"
                  ToolTip="Replace the current conflict with the TARGET (current) lines">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="3" Height="14" Margin="0,0,5,0" Fill="{StaticResource TargetBrush}" />
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.KeepTargetVersion}" />
              <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Take target" />
            </StackPanel>
          </Button>
          <Button Margin="0,1,0,1" MinWidth="0" MinHeight="24" Padding="7,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding TakeBothBlockCommand}"
                  ToolTip="Keep both: the SOURCE lines first, then the TARGET lines">
            <StackPanel Orientation="Horizontal">
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Merge}" />
              <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="Take both" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </autoMerge:ConflictHeaderPanel>
    </Border>

    <!-- 1: errore ben visibile -->
    <Border Grid.Row="1" Margin="10,6,10,0" Padding="10,5" BorderThickness="3,0,0,0"
            BorderBrush="{StaticResource ErrorBrush}"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.InfoBackgroundKey}}"
            Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,9,0" VerticalAlignment="Top"
                            Moniker="{x:Static catalog:KnownMonikers.StatusError}" />
        <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,1" VerticalAlignment="Top"
                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                Content="Retry" Command="{Binding RetryLoadCommand}"
                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.InfoTextKey}}"
                   Text="{Binding ErrorMessage, Mode=OneWay}" />
      </DockPanel>
    </Border>

    <!-- 2: avvertenza sulla fusione (base assente, confronto semplificato): una riga -->
    <Border Grid.Row="2" Margin="10,6,10,0" Padding="8,3" BorderThickness="3,0,0,0"
            BorderBrush="{StaticResource WarningBrush}"
            Background="{DynamicResource {x:Static vsshell:VsBrushes.InfoBackgroundKey}}"
            Visibility="{Binding HasConflictNote, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,8,0" Moniker="{x:Static catalog:KnownMonikers.StatusInformation}" />
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.InfoTextKey}}"
                   Text="{Binding ConflictNote, Mode=OneWay}" ToolTip="{Binding ConflictNote, Mode=OneWay}" />
      </DockPanel>
    </Border>

    <!-- 3a: caricamento -->
    <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
      <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10" Style="{StaticResource SecondaryText}"
                 Text="Loading the source, target and base versions..." />
      <ProgressBar Width="260" Height="4" IsIndeterminate="True"
                   Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ProgressBarStyleKey}}" />
    </StackPanel>

    <!-- 3b: editor a tre vie (conflitto di contenuto): confronto 3*, divisore, risultato 2* -->
    <Grid x:Name="EditorGrid" Grid.Row="3" Margin="10,6,10,0"
          Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="DiffRow" Height="3*" MinHeight="150" />
        <RowDefinition Height="7" />
        <RowDefinition x:Name="ResultRow" Height="2*" MinHeight="110" />
      </Grid.RowDefinitions>

      <!-- Confronto affiancato: SOURCE (incoming) a sinistra, TARGET (current) a destra -->
      <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource PaneHeader}" BorderBrush="{StaticResource SourceBrush}">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run FontWeight="SemiBold" Text="SOURCE" />
              <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="(incoming, read-only)" />
            </TextBlock>
          </Border>
          <Border Grid.Column="1" Margin="8,0,0,4" Style="{StaticResource PaneHeader}" BorderBrush="{StaticResource TargetBrush}">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run FontWeight="SemiBold" Text="TARGET" />
              <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" Text="(current, read-only)" />
            </TextBlock>
          </Border>
        </Grid>
        <Border Grid.Row="1" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
          <Grid>
            <!-- Il visore differenze di VS (creato nel code-behind). -->
            <Border x:Name="DiffViewerHost" />
            <!-- Ripiego se il visore non si puo' creare: due TextBox affiancate in sola lettura. -->
            <Grid x:Name="FallbackDiffGrid" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FallbackSourceBox" Grid.Column="0"
                       Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                       Padding="4,2" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" SpellCheck.IsEnabled="False" IsInactiveSelectionHighlightEnabled="True"
                       IsReadOnly="True" IsUndoEnabled="False" BorderThickness="0"
                       AutomationProperties.Name="Source version" />
              <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                            ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                            Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
              <TextBox x:Name="FallbackTargetBox" Grid.Column="2"
                       Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                       Padding="4,2" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" SpellCheck.IsEnabled="False" IsInactiveSelectionHighlightEnabled="True"
                       IsReadOnly="True" IsUndoEnabled="False" BorderThickness="0"
                       AutomationProperties.Name="Target version" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Divisore confronto / risultato (le proporzioni restano per i conflitti successivi) -->
      <GridSplitter x:Name="BodySplitter" Grid.Row="1" Style="{StaticResource RowSplitter}"
                    DragCompleted="BodySplitter_DragCompleted" />

      <!-- Risultato modificabile -->
      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,4" Height="17">
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                     Style="{StaticResource SecondaryText}"
                     ToolTip="The result is saved with the encoding and line endings of the target"
                     Text="{Binding EncodingText, Mode=OneWay}" />
          <Border Style="{StaticResource PaneHeader}" Margin="0" BorderBrush="{StaticResource SuccessBrush}"
                  ToolTip="Pick a side for each conflict with the buttons above, or edit the text here by hand: this text replaces the file in the target when you accept it">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
              <Run FontWeight="SemiBold" Text="RESULT" />
              <Run Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"
                   Text="(editable: pick a side above or edit by hand; this text replaces the file in the target)" />
            </TextBlock>
          </Border>
        </DockPanel>
        <!-- Blocco corrente nel RESULT: fascia + barretta disegnate sopra il testo (la selezione di una
             TextBox che non ha mai avuto il fuoco non si vede, nemmeno con IsInactiveSelectionHighlightEnabled). -->
        <Canvas x:Name="ResultOverlay" Grid.Row="1" Panel.ZIndex="1" IsHitTestVisible="False" ClipToBounds="True">
          <Rectangle x:Name="CurrentBlockBand" Visibility="Collapsed" Opacity="0.16"
                     Fill="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
          <Rectangle x:Name="CurrentBlockMarker" Visibility="Collapsed" Width="3"
                     Fill="{StaticResource WarningBrush}" />
        </Canvas>
        <!-- Padding a sinistra piu' largo: ci passa la barretta del blocco corrente. -->
        <TextBox x:Name="ResultTextBox" Grid.Row="1"
                 Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}"
                 Padding="7,2,4,2" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" SpellCheck.IsEnabled="False" IsInactiveSelectionHighlightEnabled="True"
                 AcceptsTab="True" IsUndoEnabled="True" UndoLimit="500"
                 IsReadOnly="{Binding IsResultReadOnly, Mode=OneWay}"
                 AutomationProperties.Name="Merged result"
                 TextChanged="ResultTextBox_TextChanged"
                 SelectionChanged="ResultTextBox_SelectionChanged"
                 LostKeyboardFocus="ResultTextBox_LostKeyboardFocus" />
      </Grid>
    </Grid>

    <!-- 3c: conflitti non di contenuto (binari, cancellazioni, nomi, file enormi): solo il file intero -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding ShowFileCard, Converter={StaticResource BoolToVisibility}}">
      <Border Margin="10" Padding="18,16" MinWidth="420" MaxWidth="760" HorizontalAlignment="Left"
              VerticalAlignment="Top" BorderThickness="1"
              BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}">
        <StackPanel>
          <DockPanel>
            <imaging:CrispImage DockPanel.Dock="Left" Margin="0,0,10,0"
                                Moniker="{x:Static catalog:KnownMonikers.StatusWarning}" />
            <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="This conflict cannot be merged line by line" />
          </DockPanel>
          <!-- Cosa e' successo (l'intestazione e' una riga sola: qui per intero) e perche'. -->
          <TextBlock Margin="26,8,0,0" TextWrapping="Wrap" Text="{Binding ConflictDescription, Mode=OneWay}" />
          <TextBlock Margin="26,4,0,0" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                     Text="{Binding ContentUnavailableReason, Mode=OneWay}" />
          <TextBlock Margin="26,14,0,8" TextWrapping="Wrap" Text="Choose the version to keep in the target:" />
          <WrapPanel Margin="26,0,0,0">
            <Button Margin="0,0,8,6" Padding="10,4"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                    Command="{Binding TakeSourceFileCommand}"
                    ToolTip="Resolve the conflict with the version of the source branch (TFVC: AcceptTheirs)">
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="14" Margin="0,0,6,0" Fill="{StaticResource SourceBrush}" />
                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.TakeSourceVersion}" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding TakeSourceFileText, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Margin="0,0,8,6" Padding="10,4"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                    Command="{Binding KeepTargetFileCommand}"
                    ToolTip="Resolve the conflict keeping the version of the target branch (TFVC: AcceptYours)">
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" Height="14" Margin="0,0,6,0" Fill="{StaticResource TargetBrush}" />
                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.KeepTargetVersion}" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding KeepTargetFileText, Mode=OneWay}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <StackPanel Margin="26,6,0,0" Orientation="Horizontal"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ProgressBarStyleKey}}" />
            <TextBlock Margin="8,0,0,0" Style="{StaticResource SecondaryText}" Text="{Binding StatusText, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- 4: piede dell'editor: Accept result (principale) | file intero + suggerimento. Con la colonna
         stretta i pulsanti vanno a capo (WrapPanel) invece di essere tagliati; il suggerimento prende
         lo spazio che resta (troncato, per intero nel tooltip). -->
    <Border Grid.Row="4" Margin="0,6,0,0" Padding="10,5,10,5" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Margin="0,1" MinWidth="130" MinHeight="24" Padding="12,2" FontWeight="SemiBold"
                  VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding AcceptResultCommand}"
                  ToolTip="Save the result in the target and mark the conflict as resolved (enabled when no conflict is left)">
            <StackPanel Orientation="Horizontal">
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusOK}" />
              <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Accept result" />
            </StackPanel>
          </Button>
          <Rectangle Width="1" Margin="12,4" VerticalAlignment="Stretch"
                     Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
          <Button Margin="0,1,6,1" MinWidth="0" MinHeight="24" Padding="9,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding TakeSourceFileCommand}"
                  ToolTip="Ignore the result: resolve with the whole source file (TFVC: AcceptTheirs)">
            <StackPanel Orientation="Horizontal">
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.TakeSourceVersion}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding TakeSourceFileText, Mode=OneWay}" />
            </StackPanel>
          </Button>
          <Button Margin="0,1" MinWidth="0" MinHeight="24" Padding="9,2" VerticalAlignment="Center"
                  Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}"
                  Command="{Binding KeepTargetFileCommand}"
                  ToolTip="Ignore the result: keep the whole target file (TFVC: AcceptYours)">
            <StackPanel Orientation="Horizontal">
              <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.KeepTargetVersion}" />
              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding KeepTargetFileText, Mode=OneWay}" />
            </StackPanel>
          </Button>
          <ProgressBar Width="80" Height="4" Margin="14,0,0,0" IsIndeterminate="True"
                       VerticalAlignment="Center"
                       Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ProgressBarStyleKey}}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Style="{StaticResource SecondaryText}"
                   Text="{Binding StatusText, Mode=OneWay}" ToolTip="{Binding StatusText, Mode=OneWay}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
